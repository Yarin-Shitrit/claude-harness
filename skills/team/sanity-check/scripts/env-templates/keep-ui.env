# keep-ui/.env — canonical sanity-check dev config.
# Copy to keep-ui/.env before running `npm run dev`.
NEXTAUTH_URL=http://localhost:3000

# Required for NextAuth. Generate your own: `openssl rand -hex 32`.
NEXTAUTH_SECRET=your-secret-key-here-generate-one

# Where the Keep backend (api-gateway) is running. The gateway binds 8080, so
# this MUST be 8080 — a stale 8000 here makes every UI request hit a dead port.
API_URL=http://localhost:8080

# Workflows are served by a SEPARATE microservice (keep-workflows on :8081), not
# the gateway. The UI middleware proxies /backend/workflows/* to this URL; its
# default is :8082, which is dead here — leave this unset and the workflows page
# hangs forever on its loader.
WORKFLOWS_API_URL=http://localhost:8081

# No-auth mode.
AUTH_TYPE=noauth

# Real-time updates via Pusher / soketi (docker-compose.infra.yml).
PUSHER_HOST=localhost
PUSHER_PORT=6001
PUSHER_APP_KEY=keepappkey

# Logging
LOG_FORMAT=dev_terminal
